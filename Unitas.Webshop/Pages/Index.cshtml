@page
@using Unitas.Webshop.Data
@{
    ViewData["Title"] = "Machines";
    ViewData["Navigation"] = "Machines";
}
<section class="hero">
    <div class="hero-inner">
        <p class="eyebrow">Unitas Bakery Systems</p>
        <h1>Machines voor<br />professionele bakkers.</h1>
        <p>Van deegbereiding tot oven. Bekijk de machines, vind de juiste handleiding en vraag een offerte aan.</p>
        <div class="actions">
            <a href="#assortiment" class="button">Bekijk machines</a>
            <a asp-page="/Portal" class="button light">Klantenportaal</a>
        </div>
    </div>
</section>
<section id="assortiment" class="section">
    <div class="section-head"><h2>Ons assortiment</h2><p>Deegbereiding, portioneren en bakken</p></div>
    <div class="products">
        @foreach (var product in Catalog.Products)
        {
            <article class="product">
                <div class="product-band @product.Accent">@product.Type</div>
                <div class="card-body">
                    <h3>@product.Name</h3>
                    <p>@product.Description</p>
                    <p class="spec">@product.Capacity</p>
                    <a class="button outline" asp-page="/Machines/Product" asp-route-id="@product.Id">Bekijk machine</a>
                </div>
            </article>
        }
    </div>
</section>
